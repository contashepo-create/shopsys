{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["guardNavigation", "useUnsavedChangesGuard", "useToast", "DEFAULT_PAY_SOURCE"] }]
  }
}
